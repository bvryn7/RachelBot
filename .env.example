# Server
PORT=3100
DATA_DIR=./data

# Anthropic Claude (reply drafting, model claude-opus-5-5)
ANTHROPIC_API_KEY=

# Microsoft Graph - same Entra app registration as the order-entry project.
# Mail.Read is enough: this bot never writes to the mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Shared mailbox Rachel answers from. Her replies live in its Sent Items folder.
GRAPH_MAILBOX=bulman@bulmanproducts.com
# HARD RULE carried over from order entry: mail newer than this is never read.
GRAPH_MIN_AGE_DAYS=25
# Rachel's own mailbox: her sent replies live here, not in the shared box's Sent Items.
RACHEL_MAILBOX=rbowman@bulmanproducts.com

# JobBoss2 production company, READ ONLY (parts, descriptions, prices, customers, order status)
JB2_AUTH_HOST=https://api-user.integrations.ecimanufacturing.com
JB2_API_HOST=https://api-jb2.integrations.ecimanufacturing.com
JB2_API_KEY=
JB2_PROD_CLIENT_ID=
JB2_PROD_CLIENT_SECRET=
