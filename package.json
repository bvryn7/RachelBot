{
  "name": "bulman-cs-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Customer service reply bot trained on Rachel's email history: quoting, dimensions, product info, catalogue",
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "corpus:harvest": "tsx src/corpus/harvestRachel.ts",
    "corpus:stats": "tsx src/corpus/stats.ts",
    "knowledge:build": "tsx src/knowledge/build.ts",
    "jb2:refresh": "tsx src/jobboss/refresh.ts",
    "draft": "tsx src/bot/cli.ts",
    "knowledge:prices": "tsx src/knowledge/prices.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
